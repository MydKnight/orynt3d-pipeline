# Dependencies
node_modules/

# Build output
dist/

# Environment (contains real NAS paths)
.env

# Temp extraction folder
temp/

# Saved tagging sessions (contain personal tag data, not source)
sessions/

# Generated import manifests (old Python script output)
orynt3d_import.json

