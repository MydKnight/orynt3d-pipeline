data/*
!data/pipeline.db

# Saved browser sessions (contain auth cookies — never commit)
.sessions/

# Debug HTML dumps from scraper runs
debug/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OS
.DS_Store
Thumbs.db
