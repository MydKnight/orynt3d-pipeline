# Path to the root 3D Files folder on the NAS where organized output goes
# UNC path example:
NAS_3D_FILES_PATH=\\192.168.254.200\data\3D Files

# Parent folder for the local staging tree (.orynt-staging/) the pipeline builds
# before syncing to the NAS. Pick a drive with room for a full release (~12 GB).
# Defaults to the OS temp dir if not set.
STAGING_PATH=C:\Users\shilo\Downloads
