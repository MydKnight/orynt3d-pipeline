# Copy to `.env` in this directory and fill in the real values on the QNAP.
# `docker compose` reads `.env` automatically, so once it exists you just run:
#   docker compose -f compose.nas.yml run --rm pipeline
# `.env` is gitignored; `.env.example` is committed.

# GitHub fine-grained PAT, scoped to MydKnight/orynt3d-pipeline, Contents: write.
# The container uses it to push the data/pipeline.db snapshot after each run.
GH_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxx

# Host path to the 3D Files share on the QNAP (mounted rw -- the pipeline writes here).
NAS_3DFILES=/share/CACHEDEV1_DATA/data/3D Files

# Host path to a folder where you stage downloaded archives (mounted ro).
NAS_DOWNLOADS=/share/CACHEDEV1_DATA/data/downloads

# Optional -- defaults shown.
# TARGET_BRANCH=master
# GIT_NAME=Shiloh Madsen
# GIT_EMAIL=shiloh.madsen@gmail.com
